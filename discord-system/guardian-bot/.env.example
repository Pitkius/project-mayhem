# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Application ID (same as Client ID in Developer Portal)
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: guild ID for instant slash command deploy during development
DISCORD_GUILD_ID=your_discord_guild_id_here

# Bot display name (default: MRP)
BOT_USERNAME=MRP

# SQLite database path (relative to guardian-bot folder)
DATABASE_PATH=./data/guardian.json

# Jei true — botas startup metu sukuria logų kanalus serveriuose be konfigūracijos
AUTO_PROVISION_LOGS=false
