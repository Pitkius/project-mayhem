# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Application ID (same as Client ID in Developer Portal)
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: guild ID for instant slash command deploy during development
DISCORD_GUILD_ID=your_discord_guild_id_here

# Sync slash commands on every bot start (recommended: true)
SYNC_COMMANDS_ON_START=true

# Bot display name (default: MRP)
BOT_USERNAME=MRP

# SQLite database path (relative to guardian-bot folder)
DATABASE_PATH=./data/guardian.json

# Jei true — botas startup metu sukuria logų kanalus serveriuose be konfigūracijos
AUTO_PROVISION_LOGS=false

# Papildomos rolės, kurios mato logų kanalus (be Administrator). Kableliais: 123,456
# DISCORD_LOG_ROLE_IDS=

# ── Discord narių skaičius voice kanale (SERVERIO STATISTIKA) ──
DISCORD_STATS_ENABLED=true
# Voice kanalo ID — Copy Channel ID
DISCORD_STATS_CHANNEL_ID=
# Kanalo pavadinimo šablonas: {members} = visi nariai, {online} = prisijungę
DISCORD_STATS_CHANNEL_TEMPLATE=Gyventojai: {members}
DISCORD_STATS_INTERVAL_MS=60000
DISCORD_STATS_MIN_RENAME_MS=60000
# Live atnaujinimas kai narys prisijungia / išeina (debounce ms)
DISCORD_STATS_EVENT_DEBOUNCE_MS=3000
DISCORD_STATS_EVENT_MIN_RENAME_MS=15000
DISCORD_STATS_UPDATE_PRESENCE=true
# Jei channel ID nenurodytas — ieško voice kanalo su „Gyventojai“ pavadinime
DISCORD_STATS_CHANNEL_MATCH=Gyventojai
