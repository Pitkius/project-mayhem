[Unit]
Description=MRP Discord Guardian Bot
Documentation=file:///home/fivem/FIVEMPROJEKTAS/discord-system/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# VPS dažnai neturi userio "fivem" — default root (pakeisk setup skriptu jei reikia)
User=root
Group=root
WorkingDirectory=/home/fivem/FIVEMPROJEKTAS/discord-system/guardian-bot
Environment=MRP_DISCORD_ENV_FILE=/home/fivem/.config/mrp-discord.env
ExecStart=/bin/bash /home/fivem/FIVEMPROJEKTAS/discord-system/guardian-bot/scripts/run-bot.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
