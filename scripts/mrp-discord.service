[Unit]
Description=MRP Discord Guardian Bot
Documentation=file:///home/fivem/FIVEMPROJEKTAS/discord-system/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fivem
Group=fivem
WorkingDirectory=/home/fivem/FIVEMPROJEKTAS/discord-system/guardian-bot
# Token ir nustatymai (sukuriami setup-discord-bot.sh)
EnvironmentFile=-/home/fivem/.config/mrp-discord.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# Saugesni default'ai
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
